extends Node

# سنستخدم هذه المصفوفة لتوضيح التكرار عليها
var inventory = ["Sword", "Shield", "Potion", "Map"]

func _ready():
	# =========================================================
	# 1. الدوارة (for): تُستخدم عندما نعرف عدد المرات مسبقاً
	# أو عندما نريد المرور على عناصر مصفوفة (Array)
	# =========================================================
	print("--- بداية حلقة for ---")
	
	# أ) التكرار عبر مصفوفة (أكثر استخدام شائع)
	# هنا 'item' هو متغير مؤقت يأخذ قيمة العنصر في كل لفة
	for item in inventory:
		print("وجدنا في الحقيبة: ", item)
	
	print("-----------------------")
	
	# ب) التكرار لعدد محدد من المرات باستخدام range
	# range(5) تعني تكرار الكود 5 مرات (من 0 إلى 4)
	for i in range(5):
		print("هذه اللفة رقم: ", i)

	print("\n-----------------------\n")

	# =========================================================
	# 2. الدوارة (while): تُستخدم عندما لا نعرف عدد المرات
	# وتستمر في العمل "طالما" أن الشرط صحيح (true)
	# =========================================================
	print("--- بداية حلقة while ---")
	
	var energy = 3 # متغير للتحكم في الحلقة
	
	# طالما الطاقة أكبر من 0، استمر في التكرار
	while energy > 0:
		print("اللاعب يركض.. الطاقة المتبقية: ", energy)
		
		# هام جداً: يجب تقليل الطاقة وإلا ستستمر الحلقة للأبد (Crash)
		energy -= 1 
	
	print("توقف اللاعب لأن الطاقة انتهت.")

	print("\n-----------------------\n")

	# =========================================================
	# 3. مثال عملي متقدم (استخدام break)
	# كيف نخرج من الحلقة قبل أن تنتهي إذا وجدنا ما نريد؟
	# =========================================================
	
	print("--- البحث عن عنصر محدد ---")
	for item in inventory:
		if item == "Potion":
			print("تم العثور على الجرعة! سنتوقف عن البحث الآن.")
			break # تخرج فوراً من الحلقة (Loop)
		print("جاري البحث في: ", item)
