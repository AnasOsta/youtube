extends Node

# =========================================================
# الجزء الأول: تعريف المصفوفات والقواميس (على مستوى الكلاس)
# =========================================================

# المصفوفة (Array): قائمة مرتبة، نصل لعناصرها عبر أرقام (0, 1, 2...)
# نستخدمها عندما نريد "قائمة" من الأشياء المتشابهة.
var inventory_list = ["Sword", "Shield", "Healing Potion", "Mana Potion"]

# القاموس (Dictionary): مجموعة "مفتاح وقيمة" { key : value }.
# نستخدمه عندما نريد "وصف" كائن بخصائص محددة.
var player_stats = {
	"user_name": "Hero_99",  # المفتاح هو الاسم، والقيمة هي النص
	"health": 100,           # المفتاح هو الصحة، والقيمة رقم
	"level": 1,              # المفتاح هو المستوى، والقيمة رقم
	"is_online": true        # المفتاح هو الحالة، والقيمة منطقية
}

# =========================================================
# الجزء الثاني: العمليات البرمجية داخل الدوال
# =========================================================

func _ready():
	print("--- شرح المصفوفات (Arrays) ---")
	
	# 1. الوصول للعنصر عبر الفهرس (Index)
	# تذكر: العد يبدأ من 0 دائماً.
	var first_item = inventory_list[0] # سيأخذ "Sword"
	print("العنصر الأول في الحقيبة: ", first_item)
	
	# 2. معرفة طول المصفوفة (كم عنصر بداخلها)
	var total_items = inventory_list.size()
	print("عدد العناصر الإجمالي: ", total_items) # سيطبع 4
	
	# 3. إضافة عنصر جديد في نهاية القائمة
	inventory_list.append("Map") # ستصبح القائمة تحتوي على 5 عناصر
	
	# 4. تعديل عنصر موجود مسبقاً عبر فهرسه
	# سنغير "Shield" (الفهرس 1) إلى "Golden Shield"
	inventory_list[1] = "Golden Shield"
	
	# 5. حذف عنصر معين
	inventory_list.erase("Mana Potion") # يبحث عن القيمة ويحذفها
	
	print("الحقيبة النهائية: ", inventory_list)
	
	print("\n----------------------------------\n")
	print("--- شرح القواميس (Dictionaries) ---")
	
	# 1. الوصول للقيمة باستخدام "المفتاح" (Key)
	# بدلاً من رقم (0)، نستخدم الكلمة التي سميناها نحن.
	var current_hp = player_stats["health"]
	print("صحة اللاعب الحالية: ", current_hp)
	
	# 2. تعديل قيمة موجودة باستخدام مفتاحها
	# عندما يزداد مستوى اللاعب:
	player_stats["level"] = 2
	player_stats["health"] = 120 # زيادة الصحة أيضاً
	
	# 3. إضافة معلومة جديدة كلياً للقاموس
	# لم يكن لدينا "experience"، سنضيفها الآن ببساطة:
	player_stats["experience"] = 500
	
	# 4. التحقق من وجود مفتاح معين (لتجنب الأخطاء)
	if player_stats.has("is_online"):
		print("حالة اللاعب معروفة في النظام.")
	
	print("بيانات اللاعب المحدثة: ", player_stats)

	# =========================================================
	# الجزء الثالث: دمج المصفوفة مع القاموس (مستوى متقدم)
	# يمكننا وضع قاموس داخل مصفوفة!
	# =========================================================
	
	var enemies = [
		{"name": "Slime", "damage": 5},
		{"name": "Goblin", "damage": 15}
	]
	
	# الوصول لضرر الجوبلن:
	# enemies[1] تجلب القاموس الثاني، ثم ["damage"] تجلب الرقم
	print("ضرر العدو الثاني: ", enemies[1]["damage"])
