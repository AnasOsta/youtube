extends Node

# ===============================================
# 1. المتغيرات القابلة للتغيير (Variables - var)
# يتم تعريف المتغيرات باستخدام الكلمة المفتاحية 'var'.
# ===============================================

# تعريف متغير رقمي (عدد صحيح - Integer) يمكن أن يتغير.
var player_health : int = 100

# تعريف متغير نصي (String).
var player_name : String = "Knight_Alpha"

# تعريف متغير منطقي (Boolean) يحمل قيمة 'صحيح' أو 'خطأ'.
var is_game_over : bool = false

# ===============================================
# 2. الثوابت (Constants - const)
# تستخدم الكلمة المفتاحية 'const' لقيم لا تتغير أبداً أثناء تشغيل اللعبة.
# من الاصطلاح (Convention) استخدام الأحرف الكبيرة لاسم الثابت.
# ===============================================

# ثابت يحدد السرعة القصوى، لا يمكن إعادة تعيين قيمته.
const MAX_SPEED = 500

# ثابت يحدد قيمة الجاذبية في اللعبة.
const GRAVITY_STRENGTH = 9.8

# ===============================================
# 3. مثال على تغيير قيمة المتغير (للتأكيد على الفرق مع const)
# ===============================================

func _ready():
	# الدالة _ready() تُنفذ مرة واحدة عند تحميل المشهد.
	print("الصحة الابتدائية: ", player_health)
	
	# تغيير قيمة المتغير (مسموح به لأننا استخدمنا var):
	player_health = player_health - 10
	print("الصحة بعد الضرر: ", player_health)

	# محاولة تغيير قيمة ثابت (سيؤدي إلى خطأ برمجي):
	# GRAVITY_STRENGTH = 15.0  # <--- هذا السطر سيسبب خطأ ولن يعمل.
	
	print("قيمة الثابت (لا تتغير): ", MAX_SPEED)
